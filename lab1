from typing import List, Dict, Tuple, Union

def dijkstra_shortest_paths(
    graph: Union[List[List[float]], Dict[int, List[Tuple[int, float]]]],
    start: int,
    n: int = None
) -> Tuple[List[float], List[int]]:

    if isinstance(graph, list):
        n = len(graph)
        def neighbors(v):
            for u in range(n):
                w = graph[v][u]
                if w != float('inf') and w != 0 and u != v:
                    yield u, w
    else:
        if n is None:
            n = max(graph.keys()) + 1
        def neighbors(v):
            return graph.get(v, [])

    distances = [float('inf')] * n
    parents = [-1] * n
    visited = [False] * n
    distances[start] = 0

    for _ in range(n):
        u = -1
        min_dist = float('inf')
        for i in range(n):
            if not visited[i] and distances[i] < min_dist:
                min_dist = distances[i]
                u = i
        if u == -1:  
            break
        visited[u] = True
        for v, w in neighbors(u):
            new_dist = distances[u] + w
            if new_dist < distances[v]:
                distances[v] = new_dist
                parents[v] = u

    return distances, parents


def reconstruct_path(parents: List[int], target: int) -> List[int]:
    """Восстанавливает путь от начальной вершины до target по массиву родителей."""
    path = []
    v = target
    while v != -1:
        path.append(v)
        v = parents[v]
    path.reverse()
    return path

